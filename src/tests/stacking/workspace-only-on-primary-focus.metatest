resize_monitor default 800 600
add_monitor secondary 800 600
assert_primary_monitor default

num_workspaces 2

set_pref raise-on-click false
set_pref workspaces-only-on-primary true

new_client w wayland

create w/1 csd
resize w/1 100 100
show w/1

create w/2 csd
resize w/2 100 100
show w/2

wait_reconfigure w/1 w/2

# make sure the windows are on the secondary monitor
move w/1 800 0
move w/2 900 0
assert_position w/1 800 0
assert_position w/2 900 0

assert_stacking w/1 w/2
assert_focused w/2

assert_position w/1 800 0
assert_size w/1 100 100
assert_position w/2 900 0
assert_size w/2 100 100

# click on window w/1 and check that it gets focused but not raised
move_cursor_to 850 50
click
wait

assert_stacking w/1 w/2
assert_focused w/1

# Change to another workspace, create a window with focus, change back to the
# original workspace and make sure the focus for that workspace didn't change
activate_workspace 1
wait

assert_stacking w/1 w/2
assert_focused w/1

destroy w/1
destroy w/2
wait

# An automatically sticky window must not replace another workspace's MRU
# window
move_cursor_to 150 250
create w/primary csd
resize w/primary 100 100
show w/primary
wait_reconfigure w/primary

activate_workspace 0

create w/sticky csd
resize w/sticky 100 100
show w/sticky
wait_reconfigure w/sticky
move w/sticky 900 200
wait
assert_sticky w/sticky true

activate_workspace 1
wait

assert_focused w/primary

# Explicitly sticky windows should move to the front of every workspace's MRU
# list
stick w/primary
wait
activate_workspace 0
wait
assert_focused w/primary
