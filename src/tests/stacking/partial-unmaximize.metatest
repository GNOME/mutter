resize_monitor default 800 600

#
# Wayland
#

new_client w wayland

# With a saved size

create w/1 csd
resize w/1 200 200
show w/1
wait

maximize w/1
wait_reconfigure w/1
assert_size w/1 800 600
assert_position w/1 0 0

set_unmaximize_flag w/1 vertically
wait_reconfigure w/1

assert_size w/1 800 200
assert_position w/1 0 200

destroy w/1

# Wihout a saved size
# !!! Currently doesn't work

create w/2 csd
resize w/2 200 200
maximize w/2
show w/2
wait

assert_size w/2 800 600
assert_position w/2 0 0

set_unmaximize_flag w/2 vertically
wait_reconfigure w/2

# NOTE: This is not optimal, ideally we should unmaximize to 800x200 by letting
# the client decide only the height.
assert_size w/2 800 600
assert_position w/2 0 0

destroy w/2

#
# X11
#

new_client x x11

# With a saved size

create x/1 csd
resize x/1 200 200
show x/1
wait

maximize x/1
wait_reconfigure x/1
assert_size x/1 800 600
assert_position x/1 0 0

set_unmaximize_flag x/1 vertically
wait_reconfigure x/1

assert_size x/1 800 200
assert_position x/1 0 200

destroy x/1

# Wihout a saved size

create x/2 csd
resize x/2 200 200
maximize x/2
show x/2
wait

assert_size x/2 800 600
assert_position x/2 0 0

set_unmaximize_flag x/2 vertically
wait_reconfigure x/2

assert_size x/2 800 200
# NOTE: This is not optimal, ideally we place the window on the vertical axis
# more according somewhere other than at 0
assert_position x/2 0 0

destroy x/2
